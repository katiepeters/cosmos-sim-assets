#usda 1.0
(
    defaultPrim = "Ball"
    doc = """A slightly squishy 35 mm ball for the cosmos-tutorial pick task.

    It is a rigid body with compliant (spring-damper) contacts, so it gives a
    little under the Lite6 gripper's 2 N closing effort without being a
    deformable body. It is wider than the 31.3 mm pick block so the jaws stop
    well short of their 22.4 mm closed gap, and still clears the 40.2 mm open
    gap by about 2.6 mm a side.

    Load it as a sim-world prop: {"type": "usd", "name": "pick_ball",
    "usd_path": "<path to this file>", "position": [...]}"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Ball" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.025
    # Rolling balls never settle on their own; a little damping lets an
    # undisturbed ball come to rest instead of drifting off the table.
    float physxRigidBody:angularDamping = 0.5
    float physxRigidBody:linearDamping = 0.05

    def Sphere "Collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double radius = 0.0175
        float3[] extent = [(-0.0175, -0.0175, -0.0175), (0.0175, 0.0175, 0.0175)]
        color3f[] primvars:displayColor = [(0.1, 0.3, 0.9)]
        rel material:binding = </Ball/Looks/Rubber>
        rel material:binding:physics = </Ball/Looks/SquishyPhysics> (
            bindMaterialAs = "weakerThanDescendants"
        )
    }

    def Scope "Looks"
    {
        def Material "Rubber"
        {
            token outputs:surface.connect = </Ball/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.3, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "SquishyPhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            # Grippy rubber, matching the cube props' default friction.
            float physics:staticFriction = 1
            float physics:dynamicFriction = 1
            # Compliant contact: ~2500 N/m compresses ~0.8 mm under the 2 N grip
            # and ~0.1 mm under the ball's own weight. At 800 N/m the jaws sank
            # ~9 mm into a 31.3 mm ball and never registered a firm grasp.
            # Restitution is ignored for compliant contacts; the damping sets
            # how bouncy it feels.
            float physxMaterial:compliantContactStiffness = 2500
            float physxMaterial:compliantContactDamping = 10
            float physics:restitution = 0
        }
    }
}
